# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Weatherstack API -------------------------------------------------------
# Get a key at https://weatherstack.com/. Free-tier plans are HTTP-only and
# quota-limited — see README "API quota" section before setting
# INGESTION_POLL_INTERVAL_MINUTES below, ingesting 5 cities every 5 minutes is
# ~43k requests/month.
WEATHERSTACK_API_KEY=changeme
WEATHERSTACK_BASE_URL=http://api.weatherstack.com/current
# Set true for local dev / CI so no real API quota is consumed; ingestion DAG
# will use fixture data from tests/fixtures instead.
USE_MOCK_CLIENT=false

# --- Postgres (shared instance, 3 logical databases) ------------------------
POSTGRES_USER=weatherdb_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_APP_DB=weather_db
POSTGRES_AIRFLOW_DB=airflow_db
POSTGRES_MLFLOW_DB=mlflow_db

# Full DSN the app/Alembic use for weather_db (localhost:5434 when running
# outside docker-compose against the mapped port; postgres:5432 from inside).
DATABASE_URL=postgresql+psycopg2://weatherdb_user:changeme@localhost:5434/weather_db

# --- MLflow -------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://weatherdb_user:changeme@postgres:5432/mlflow_db
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_DISABLE_AGENT_HINT=1

# --- Airflow --------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__WEBSERVER__SECRET_KEY=changeme-generate-a-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=changeme-generate-a-fernet-key
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://weatherdb_user:changeme@postgres:5432/airflow_db
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Pipeline behavior ------------------------------------------------------
INGESTION_POLL_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECONDS=10
FEATURE_LOOKBACK_HOURS=24
MODEL_REFRESH_INTERVAL_SECONDS=600
IMPROVEMENT_THRESHOLD=0.02
LOG_LEVEL=INFO

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Dashboard ----------------------------------------------------------------
# Talks only to the API above (Postgres-backed) — refreshing/polling the
# dashboard never calls weatherstack, regardless of DASHBOARD_REFRESH_SECONDS.
DASHBOARD_API_BASE_URL=http://localhost:8811
DASHBOARD_PORT=8050
DASHBOARD_REFRESH_SECONDS=60
